{
	"name": "n8n-nodes-parseable",
	"version": "0.1.1",
	"description": "n8n community node for querying and ingesting data with Parseable",
	"license": "AGPL-3.0-only",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"parseable",
		"observability",
		"logs"
	],
	"author": {
		"name": "Parseable",
		"email": "hello@parseable.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/parseablehq/n8n-nodes.git"
	},
	"homepage": "https://www.parseable.com/docs",
	"bugs": {
		"url": "https://github.com/parseablehq/n8n-nodes/issues"
	},
	"engines": {
		"node": ">=22.21.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"SECURITY.md"
	],
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/ParseableApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Parseable/Parseable.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.47.2",
		"eslint": "9.29.0",
		"prettier": "^3.9.6",
		"release-it": "^21.0.2",
		"typescript": "6.0.3",
		"vitest": "^5.0.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
